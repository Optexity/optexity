{
  "url": "https://www.booking.com",
  "parameters": {
    "input_parameters": {
      "destination_city": [
        "Gurgaon"
      ],
      "check_in_date": [
        "Friday, 25 September"
      ],
      "check_out_date": [
        "Monday, 28 September"
      ],
      "number_of_rooms": [
        "1"
      ],
      "first_name": [
        "John"
      ],
      "last_name": [
        "Doe"
      ],
      "email_address": [
        "john.doe@example.com"
      ],
      "phone_number": [
        "5551234567"
      ],
      "arrival_time_slot": [
        "1"
      ]
    },
    "generated_parameters": {}
  },
  "nodes": [
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "get_by_label(\"Dismiss sign in information.\")",
          "prompt_instructions": "Close the Genius popup if it appears.",
          "optional": true
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "locator(\"#searchbox-horizontal-destination-input\")",
          "prompt_instructions": "Click 'Enter destination'."
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "input_text": {
          "command": "locator(\"#searchbox-horizontal-destination-input\")",
          "prompt_instructions": "Enter the Enter destination '{destination_city[0]}' into the field.",
          "input_text": "{destination_city[0]}"
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "get_by_role(\"option\", name=\"{destination_city[0]} Haryana, India\")",
          "prompt_instructions": "Click '{destination_city[0]} Haryana, India'."
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "get_by_role(\"gridcell\", name=\"{check_in_date[0]} 2026\")",
          "prompt_instructions": "Click '{check_in_date[0]} 2026'."
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "get_by_role(\"gridcell\", name=\"{check_out_date[0]} 2026\")",
          "prompt_instructions": "Click '{check_out_date[0]} 2026'."
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "get_by_role(\"button\", name=\"Search\")",
          "prompt_instructions": "Click 'Search'."
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "scroll": {
          "down": true
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "scroll": {
          "down": false
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "go_to_url": {
          "url": "https://www.booking.com/searchresults.en-gb.html?ss={destination_city[0]}&checkin=2026-09-25&checkout=2026-09-28&group_adults=2&no_rooms=1&group_children=0&order=price"
        }
      }
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "locator(\"[data-testid=\\\"title-link\\\"]\").nth(0)",
          "prompt_instructions": "Click the first hotel in the sorted results."
        }
      },
      "expect_new_tab": true
    },
    {
      "type": "action_node",
      "interaction_action": {
        "select_option": {
          "command": "locator('[data-testid=\"select-room-trigger\"]').nth(0)",
          "select_values": [
            "{number_of_rooms[0]}"
          ],
          "prompt_instructions": "Select the number of rooms"
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "scroll": {
          "down": true,
          "amount": 3
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "get_by_role(\"button\", name=\"I'll\\u00a0reserve\")",
          "prompt_instructions": "Click the Reserve button"
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "input_text": {
          "command": "locator('[data-testid=\"user-details-firstname\"]')",
          "input_text": "{first_name[0]}",
          "prompt_instructions": "Enter first name"
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "input_text": {
          "command": "locator('[data-testid=\"user-details-lastname\"]')",
          "input_text": "{last_name[0]}",
          "prompt_instructions": "Enter last name"
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "input_text": {
          "command": "locator('[data-testid=\"user-details-email\"]')",
          "input_text": "{email_address[0]}",
          "prompt_instructions": "Enter email address"
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "input_text": {
          "command": "locator('[data-testid=\"phone-number-input\"]')",
          "input_text": "{phone_number[0]}",
          "prompt_instructions": "Enter phone number"
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "select_option": {
          "command": "locator('[data-testid=\"arrival-time-dropdown\"]')",
          "select_values": [
            "{arrival_time_slot[0]}"
          ],
          "prompt_instructions": "Select estimated arrival time"
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "get_by_role(\"button\", name=\"Next: Final details\")",
          "prompt_instructions": "Click Next: Final details button"
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "scroll": {
          "down": false,
          "amount": 3
        }
      },
      "expect_new_tab": false
    },
    {
      "type": "action_node",
      "interaction_action": {
        "click_element": {
          "command": "get_by_role(\"button\", name=\"Complete booking\")",
          "prompt_instructions": "Click Complete booking button"
        }
      },
      "expect_new_tab": false
    }
  ]
}
